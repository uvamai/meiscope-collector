#!/usr/bin/env bash
# Meiscope pre-push guard (compensating control: no branch protection on GitHub Free).
# Refuses any push to main and any push that is not a fast-forward (force-push).
# Installed by "task hooks". A deliberate bypass needs --no-verify, and the
# main-guard workflow then raises an alarm for a direct push to main.
set -u

zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      echo "pre-push: refusing to push to ${remote_ref#refs/heads/}. Push a branch and open a pull request." >&2
      status=1
      continue
      ;;
  esac
  # Deleting any other branch is allowed.
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  # A new remote ref has nothing to overwrite.
  if [ "$remote_sha" = "$zero" ]; then
    continue
  fi
  # Anything else must fast-forward. A remote commit we do not have locally
  # cannot be verified, so it is refused as well.
  if ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null ||
    ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push: refusing a non-fast-forward (force) push to $remote_ref. Add a new commit instead." >&2
    status=1
  fi
done

exit "$status"
