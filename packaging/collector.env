# meiscope-collector environment, read by the systemd unit.
# Contains no secrets. The collector's identity is created by
# "meiscope-collector enrol" in /var/lib/meiscope-collector, not written here.

# Base URL of the Meiscope core (https only). Needed by "enrol"; after
# enrolment "run" uses the URL stored with the identity and refuses to start
# if this one differs.
#MEISCOPE_CORE_URL=https://meiscope.example.internal

# The core's CA certificate, for the first contact by "enrol" only.
#MEISCOPE_CA_BUNDLE=/etc/meiscope-collector/core-ca.pem

# Enrolled collector (docs/install.md, "Running an enrolled collector").
#MEISCOPE_SCOPE_REFRESH=5m
#MEISCOPE_CT_INTERVAL=1h

# Local health endpoint; keep it on loopback unless a monitor needs it.
#MEISCOPE_HEALTH_ADDR=127.0.0.1:8090

#MEISCOPE_LOG_LEVEL=info
#MEISCOPE_LOG_FORMAT=json
